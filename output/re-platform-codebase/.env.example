# Copy to .env (never commit real keys).

# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# AI provider mode: anthropic | offline
#  - anthropic: Claude via @anthropic-ai/sdk, with retry, circuit breaker, model fallback
#               and deterministic fallback when every provider fails
#  - offline:   deterministic agents only (no network calls)
# Default: anthropic when ANTHROPIC_API_KEY is set, otherwise offline.
RE_AI_MODE=

# Anthropic credentials (read by the SDK)
ANTHROPIC_API_KEY=

# Models (primary → fallback provider chain)
RE_PRIMARY_MODEL=claude-opus-5-5
RE_FALLBACK_MODEL=claude-sonnet-5-5

# Server-side refusal fallback on the Claude API: default | off
RE_SERVER_FALLBACKS=default

# Resilience
RE_AGENT_TIMEOUT_MS=120000
RE_AGENT_MAX_RETRIES=2
RE_AGENT_REPAIR_ROUNDS=1
RE_CIRCUIT_FAILURE_THRESHOLD=3
RE_CIRCUIT_COOLDOWN_MS=30000
